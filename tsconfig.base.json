{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@opengso/core": [
        "./packages/core/src/index.js"
      ],
      "@opengso/core/shared": [
        "./packages/core/src/shared/index.js"
      ],
      "@opengso/core/generate": [
        "./packages/core/src/generate/index.js"
      ],
      "@opengso/core/test": [
        "./packages/core/src/test/index.js"
      ],
      "@opengso/core/prod": [
        "./packages/core/src/prod/index.js"
      ],
      "@opengso/core/prod/next": [
        "./packages/core/src/prod/adapters/next.js"
      ],
      "@opengso/core/prod/edge": [
        "./packages/core/src/prod/edge.js"
      ],
      "@opengso/core/prod/node": [
        "./packages/core/src/prod/adapters/node.js"
      ],
      "@opengso/core/prod/fetch": [
        "./packages/core/src/prod/adapters/fetch.js"
      ],
      "@opengso/core/prod/vite": [
        "./packages/core/src/prod/adapters/vite.js"
      ],
      "@opengso/core/server": [
        "./packages/core/src/server/index.js"
      ],
      "@opengso/core/cli": [
        "./packages/core/src/cli/index.js"
      ],
      "@opengso/core/cli/commands/*": [
        "./packages/core/src/cli/commands/*.js"
      ]
    },
    "allowJs": true,
    "checkJs": true
  }
}
