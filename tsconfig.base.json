{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@opengeo/core": [
        "./packages/core/src/index.ts"
      ],
      "@opengeo/core/shared": [
        "./packages/core/src/shared/index.ts"
      ],
      "@opengeo/core/generate": [
        "./packages/core/src/generate/index.ts"
      ],
      "@opengeo/core/test": [
        "./packages/core/src/test/index.ts"
      ],
      "@opengeo/core/prod": [
        "./packages/core/src/prod/index.ts"
      ],
      "@opengeo/core/prod/next": [
        "./packages/core/src/prod/adapters/next.ts"
      ],
      "@opengeo/core/server": [
        "./packages/core/src/server/index.ts"
      ],
      "@opengeo/core/cli": [
        "./packages/core/src/cli/index.ts"
      ],
      "@opengeo/core/cli/commands/*": [
        "./packages/core/src/cli/commands/*.ts"
      ]
    }
  }
}
