{
  "name": "opengso-generate",
  "version": "0.1.2",
  "description": "Write a markdown twin of every page, plus robots.txt, llms.txt and sitemap.xml, from one crawl. The generate pillar of OpenGSO.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "gso",
    "geo",
    "aeo",
    "generative-engine-optimization",
    "ai-seo",
    "llm",
    "ai-agents",
    "ai-crawler",
    "markdown",
    "llms-txt",
    "llms.txt",
    "sitemap",
    "robots-txt",
    "crawler",
    "html-to-markdown",
    "static-site"
  ],
  "homepage": "https://sherwinvishesh.github.io/OpenGSO/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherwinvishesh/OpenGSO.git",
    "directory": "packages/generate"
  },
  "bugs": {
    "url": "https://github.com/sherwinvishesh/OpenGSO/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "opengso": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "jsdom": "^30.1.3"
  },
  "devDependencies": {
    "@opengso/core": "*",
    "tsup": "^9.0.0",
    "typescript": "^5.8.3"
  }
}
