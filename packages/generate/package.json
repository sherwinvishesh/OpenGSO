{
  "name": "opengeo-generate",
  "version": "0.1.0",
  "description": "Generate markdown twins, robots.txt, llms.txt and sitemap.xml for AI agents. The generate pillar of OpenGEO.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "geo",
    "aeo",
    "llms-txt",
    "markdown",
    "sitemap"
  ],
  "homepage": "https://github.com/sherwinvishesh/OpenGEO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherwinvishesh/OpenGEO.git",
    "directory": "packages/generate"
  },
  "bugs": {
    "url": "https://github.com/sherwinvishesh/OpenGEO/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "opengeo": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "jsdom": "^26.1.0"
  },
  "devDependencies": {
    "@opengeo/core": "*",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
