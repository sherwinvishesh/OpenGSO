{
  "name": "opengeo",
  "version": "0.1.0",
  "description": "The full OpenGEO toolkit: test, generate, prod and the local dashboard.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "geo",
    "aeo",
    "llm",
    "seo",
    "markdown",
    "dashboard"
  ],
  "homepage": "https://github.com/sherwinvishesh/OpenGEO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherwinvishesh/OpenGEO.git",
    "directory": "packages/opengeo"
  },
  "bugs": {
    "url": "https://github.com/sherwinvishesh/OpenGEO/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "opengeo": "./dist/cli.js"
  },
  "exports": {
    "./prod": {
      "types": "./dist/prod.d.ts",
      "import": "./dist/prod.js"
    },
    "./prod/next": {
      "types": "./dist/prod-next.d.ts",
      "import": "./dist/prod-next.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && npm run build:web",
    "build:web": "tsc --noEmit -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "jsdom": "^26.1.0"
  },
  "devDependencies": {
    "@opengeo/core": "*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.6"
  }
}
