{
  "name": "opengeo",
  "version": "0.1.0",
  "description": "The full OpenGEO toolkit: test, generate, prod and the local dashboard.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "geo",
    "aeo",
    "llm",
    "seo",
    "markdown",
    "dashboard"
  ],
  "homepage": "https://github.com/sherwinvishesh/OpenGEO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherwinvishesh/OpenGEO.git",
    "directory": "packages/opengeo"
  },
  "bugs": {
    "url": "https://github.com/sherwinvishesh/OpenGEO/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "opengeo": "./dist/cli.js"
  },
  "exports": {
    "./prod": {
      "types": "./dist/prod.d.ts",
      "import": "./dist/prod.js"
    },
    "./prod/next": {
      "types": "./dist/prod-next.d.ts",
      "import": "./dist/prod-next.js"
    },
    "./prod/edge": {
      "types": "./dist/prod-edge.d.ts",
      "import": "./dist/prod-edge.js"
    }
  },
  "files": [
    "dist",
    "web",
    "!web/tsconfig.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "jsdom": "^26.1.0"
  },
  "devDependencies": {
    "@opengeo/core": "*",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
