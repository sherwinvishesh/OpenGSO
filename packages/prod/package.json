{
  "name": "opengso-prod",
  "version": "0.1.1",
  "description": "Zero-dependency middleware that serves markdown twins to AI agents at the same URL, by Accept header or User-Agent. Next.js, Express, Nuxt, SvelteKit, Astro, Hono, Vite and the edge.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "gso",
    "geo",
    "aeo",
    "generative-engine-optimization",
    "ai-seo",
    "llm",
    "ai-agents",
    "ai-crawler",
    "markdown",
    "llms-txt",
    "llms.txt",
    "middleware",
    "content-negotiation",
    "nextjs",
    "express",
    "nuxt",
    "sveltekit",
    "astro",
    "hono",
    "vite",
    "cloudflare-workers",
    "gptbot",
    "claudebot"
  ],
  "homepage": "https://github.com/sherwinvishesh/OpenGSO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherwinvishesh/OpenGSO.git",
    "directory": "packages/prod"
  },
  "bugs": {
    "url": "https://github.com/sherwinvishesh/OpenGSO/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "opengso": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@opengso/core": "*",
    "tsup": "^9.0.0",
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js",
      "default": "./dist/edge.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.js",
      "default": "./dist/fetch.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
