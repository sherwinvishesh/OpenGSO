node_modules/
dist/
# What each bundle was built from, for scripts/check-bundles.mjs. Never shipped.
.bundle-meta/
coverage/
.next/
out/
*.tgz
.env
.env.local
.DS_Store

# .opengso/manifest.json is deliberately NOT ignored: opengso-prod reads it at boot,
# so it has to travel with the deploy the same way public/md/*.md does.

# Local Claude Code workspace: CLAUDE.md, the manual testing playbook, slash commands,
# personal settings. All of it is local tooling and none of it belongs in the repo.
CLAUDE.md
.claude/

# The original product spec. It stays on the maintainer's machine. Comments across the repo
# cite its sections as §N; CONTRIBUTING.md explains that you do not need the document to
# work here. Earlier commits still contain it, which is fine and deliberate.
idea.md

# .opengso/history.json is the opposite: a local record of test runs on one machine. It feeds the
# home screen's score delta and the dashboard sparkline, and it means nothing anywhere else.
**/.opengso/history.json
**/.opengso/history.corrupt-*.json

# Running the CLI from the repo root writes its output here. These rules are anchored to the root
# on purpose: examples/nextjs-demo has the same three paths and tracks them, because they are the
# demo's generated output and prod reads them.
/.opengso/
/opengso.config.json
/public/
