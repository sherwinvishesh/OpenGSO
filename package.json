{
  "name": "opengso-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenGSO monorepo root. Never published.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "opengso": "node packages/opengso/src/cli.js",
    "build": "npm run build -w packages/testing -w packages/generate -w packages/prod -w packages/cli -w packages/opengso",
    "check:bundles": "node scripts/check-bundles.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:actions": "node scripts/check-actions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/opengso/web/tsconfig.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/check-release-versions.mjs && changeset publish",
    "example:dev": "npm run build -w packages/prod && npm run dev -w examples/nextjs-demo",
    "example:build": "npm run build -w packages/prod && npm run build -w examples/nextjs-demo",
    "example:start": "npm run start -w examples/nextjs-demo",
    "install:global": "node scripts/install-global.mjs",
    "install:global:fast": "node scripts/install-global.mjs --no-build",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
